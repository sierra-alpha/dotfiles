# gitconfig --global <some command> will change the file to be tabs
# So dont fight it...
#
[init]
	defaultBranch = main

[user]
	name = Shaun Alexander
	email = shaun@sierraalpha.co.nz
	signingkey = D7EB0DAC5825069D

[core]
	editor = vim
	excludesfile = ~/.gitignore_global
	ignorecase = false

[submodule]
	recurse = true

[push]
	autosetupremote = true
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[fetch]
	prune = true

[diff]
	colorMoved = zebra
	submodule = log

[alias]
	glog = log --oneline --decorate --graph --color -10
	delete-origin-developed-merged-branch = !git fetch && git branch -d $(git branch --merged origin/develop --format '%(refname:short)')
	delete-origin-main-merged-branch = !git fetch && git branch -d $(git branch --merged origin/main --format '%(refname:short)')

# [url "git@github.com:"]
# 	insteadOf = https://github.com/

# [url "git://"]
# 	insteadOf = https://

[includeIF "gitdir:~/mdev/trove/"]
	path = ~/mdev/trove/.gitconfig_trove

[commit]
	gpgsign = true

[gpg]
	program = gpg

